builddir = bin

python = "C:\Program Files\Python314\python.exe"
cc = compilers\Wii\1.1\mwcceppc.exe
ld = compilers\Wii\1.1\mwldeppc.exe

rule cw
  command = $cc -c $ccflags $in -o $out -MD -gccdep -DREVOLUTION -I- -i include -i include\lib -i include\lib\MSL -i include\lib\MSL\internal -i include\lib\revolution\BTE\include -i include\lib\revolution\BTE\stack\include -i include\lib\revolution\BTE\stack\btm -i include\lib\revolution\BTE\bta\include -i include\lib\revolution\BTE\bta\sys -i include\lib\revolution\BTE\gki\common -i include\lib\revolution\BTE\gki\platform
  deps = gcc
  depfile = $depfile
  description = Compile $in

rule slice_dol
  command = $python tools\slice_dol.py $in -s $symbols -o $out_dir
  description = Slice $in

rule slice_rel
  command = $python tools\slice_rel.py $in -a $alias_file -o $out_dir
  description = Slice $in

rule gen_linkerscript
  command = $python tools\gen_lcf.py $in -o $out
  description = Generate $out

rule link
  command = $ld $ldflags $in -lcf $lcf -o $out
  description = Link $out

rule build_dol
  command = $python tools\build_dol.py $in -o $out
  description = Build $out

rule write_str
  command = $python -c "import sys; open(sys.argv[1], 'w').write('\0'.join([p.replace('/', '\u005c') for p in sys.argv[2:]])+'\0')" $out $paths
  description = Write $out

rule build_rel
  command = $python tools\build_rel.py $in -o $out
  description = Build $out

rule configure
  command = $python configure.py
  generator = True
  description = Configure $out

rule decomp_context
  command = $python tools/decompctx.py $in -o $out
  depfile = $depfile
  description = Create decomp.me context for $in

build bin\compiled\wiimj2d\dol\bases\d_2d.o: cw source/dol/bases/d_2d.cpp
  ccflags = -proc gekko -fp hard -O4 -inline noauto -Cpp_exceptions off -enum int -RTTI off -ipa file -enc SJIS
  depfile = bin\compiled\wiimj2d\dol\bases\d_2d.d

