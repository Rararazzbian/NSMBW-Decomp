+/**
+ * Maps a Windows code page to the equivalent iconv character set name.
+ *
+ * Only code pages whose encoding differs meaningfully from the naive
+ * "one byte is one wide character" mapping are listed here; everything else
+ * falls back to the legacy conversion path below.
+ */
+const char *iconvCharsetForCodePage(UINT codePage) {
+	switch (codePage) {
+	case 932: // Shift-JIS
+		return "CP932";
+	case 936: // GBK
+		return "CP936";
+	case 949: // Korean
+		return "CP949";
+	case 950: // Big5
+		return "CP950";
+	case 1361: // Johab
+		return "JOHAB";
+	case 65001: // UTF-8
+		return "UTF-8";
+	default:
+		return nullptr;
+	}
+}
+
+enum class ConvResult {
+	Ok,
+	Unsupported,   // iconv does not know the charset; caller should fall back
+	Incomplete,    // input ends in the middle of a multi-byte sequence
+	InvalidSequence, // input contains a byte sequence with no mapping
+};
+
+/**
+ * Runs an iconv conversion over the whole input, appending to @p out.
+ *
+ * Invalid sequences are reported to the caller rather than being silently
+ * dropped, since MultiByteToWideChar and WideCharToMultiByte both need to
+ * distinguish "unmappable" from "truncated" input.
+ */
+ConvResult iconvConvert(const char *fromCharset, const char *toCharset, const char *src, size_t srcLen,
+						std::string &out, size_t unitSize, bool stopOnInvalid, const std::string &replacement,
+						bool *usedReplacement) {
+	iconv_t cd = iconv_open(toCharset, fromCharset);
+	if (cd == reinterpret_cast<iconv_t>(-1)) {
+		return ConvResult::Unsupported;
+	}
+
+	char *inPtr = const_cast<char *>(src);
+	size_t inLeft = srcLen;
+	char buffer[512];
+
+	while (inLeft > 0) {
+		char *outPtr = buffer;
+		size_t outLeft = sizeof(buffer);
+		size_t rc = iconv(cd, &inPtr, &inLeft, &outPtr, &outLeft);
+		out.append(buffer, sizeof(buffer) - outLeft);
+		if (rc != static_cast<size_t>(-1)) {
+			continue;
+		}
+		if (errno == E2BIG) {
+			continue; // output buffer full, flush and keep going
+		}
+		if (errno == EINVAL) {
+			iconv_close(cd);
+			return ConvResult::Incomplete;
+		}
+		if (errno == EILSEQ) {
+			if (stopOnInvalid) {
+				iconv_close(cd);
+				return ConvResult::InvalidSequence;
+			}
+			// Substitute the replacement character and skip one input unit,
+			// matching Windows' behaviour when MB_ERR_INVALID_CHARS is clear.
+			out.append(replacement);
+			if (usedReplacement) {
+				*usedReplacement = true;
+			}
+			size_t skip = std::min(unitSize, inLeft);
+			inPtr += skip;
+			inLeft -= skip;
+			continue;
+		}
+		iconv_close(cd);
+		return ConvResult::Unsupported;
+	}
+
+	iconv_close(cd);
+	return ConvResult::Ok;
+}
